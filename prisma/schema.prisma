generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Visibility {
  PUBLIC
  PRIVATE
}

model User {
  id           String   @id @default(cuid())
  name         String?
  username     String   @unique
  email        String   @unique
  passwordHash String?
  image        String?
  createdAt    DateTime @default(now())
  accounts     Account[]
  sessions     Session[]
  repos        ManualRepo[] @relation("UserRepos")
  stars        Star[]
  progresses   Progress[]
}

model ManualRepo {
  id          String     @id @default(cuid())
  ownerId     String
  owner       User       @relation("UserRepos", fields: [ownerId], references: [id])
  name        String
  slug        String
  description String?
  visibility  Visibility @default(PUBLIC)
  starsCount  Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  pages       Page[]
  stars       Star[]
  progresses  Progress[]
  @@unique([ownerId, slug])
  @@index([visibility, starsCount])
}

model Page {
  id        String    @id @default(cuid())
  repoId    String
  repo      ManualRepo @relation(fields: [repoId], references: [id])
  path      String
  title     String
  contentMd String
  order     Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  progresses Progress[]
  @@unique([repoId, path])
  @@index([repoId, order])
}

model Star {
  userId   String
  user     User       @relation(fields: [userId], references: [id])
  repoId   String
  repo     ManualRepo @relation(fields: [repoId], references: [id])
  createdAt DateTime  @default(now())
  @@id([userId, repoId])
}

model Progress {
  id             String   @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id])
  repoId         String
  repo           ManualRepo @relation(fields: [repoId], references: [id])
  pageId         String
  page           Page       @relation(fields: [pageId], references: [id])
  completedSteps Int        @default(0)
  totalSteps     Int        @default(0)
  updatedAt      DateTime   @updatedAt
  @@unique([userId, repoId, pageId])
  @@index([userId, repoId, pageId])
}

// Tabelas do NextAuth (PrismaAdapter)
model Account {
  id                String @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}